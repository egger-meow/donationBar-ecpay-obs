{
  "name": "donationbar-ecpay-obs",
  "version": "1.0.0",
  "description": "ECPay donation progress bar overlay for OBS streaming",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:ui": "node --test test/ui-scripts.test.js",
    "backup": "node operations/postgres-backup.js",
    "restore": "node operations/postgres-restore.js",
    "preflight:staging": "node operations/staging-preflight.js",
    "migrate": "node migrations/migrate.js && node migrations/run-subscription-migration.js && node migrations/run-payment-idempotency-migration.js && node migrations/run-activation-tracking-migration.js && node migrations/encrypt-provider-credentials.js"
  },
  "keywords": [
    "ecpay",
    "donation",
    "twitch",
    "obs",
    "overlay",
    "streaming",
    "progress-bar"
  ],
  "author": "Streamer",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
